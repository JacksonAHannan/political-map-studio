{
  "name": "political-map-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:cli",
    "build:cli": "esbuild scripts/render-project.tsx --bundle --platform=node --format=cjs --outfile=scripts/render-project.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "d3-geo": "latest",
    "immer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-rnd": "latest",
    "topojson-client": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/d3-geo": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/topojson-client": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "vitest": "latest"
  }
}
